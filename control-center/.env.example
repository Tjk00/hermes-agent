# ---------------------------------------------------------------------------
# Hermes Agent Control Center — environment template
#
# Copy to .env and edit. NEVER commit .env: it can contain credentials.
# Nothing here is required to start: the app runs in FREE MODE with no keys.
# ---------------------------------------------------------------------------

# --- where state lives ------------------------------------------------------
CC_HOME=/data/cc                  # database, vault, logs, backups
CC_HERMES_HOME=/data/hermes       # the agent's own home (memory, skills, config)
CC_HERMES_SOURCE=/opt/hermes-agent  # checkout of github.com/NousResearch/hermes-agent
# CC_HERMES_PYTHON=               # interpreter that has Hermes installed; auto-detected

# --- web --------------------------------------------------------------------
CC_HOST=0.0.0.0
CC_PORT=8080
CC_LOG_LEVEL=INFO
# CC_STATIC_DIR=                  # only if you serve the built UI from elsewhere

# --- the Hermes runtime we supervise ----------------------------------------
CC_RUNTIME_MODE=dashboard         # dashboard | external | disabled
CC_RUNTIME_AUTOSTART=1
CC_RUNTIME_AUTO_RESTART=1
CC_HERMES_PORT=9119               # the agent's own dashboard/API port
CC_ADOPT_EXISTING=1               # adopt a runtime we did not start, when offered
CC_CHAT_BRIDGE_PORT=9120          # the agent's OpenAI-compatible API (chat)

# --- first administrator (applied on first boot, then ignored) ---------------
CC_ADMIN_USER=admin
CC_ADMIN_PASSWORD=                # set a long unique password, or use the web wizard

# --- database ---------------------------------------------------------------
# Empty = SQLite inside CC_HOME. Zero cost, zero extra services.
CC_DATABASE_URL=
# Optional managed/free-tier PostgreSQL, for example:
# CC_DATABASE_URL=postgresql://user:password@host:5432/hermes_control_center

# --- FREE MODE and the paid guard -------------------------------------------
# Free Mode refuses every paid provider before a request leaves this app. It is the
# default and the only thing this file can set: turning Free Mode off is a decision
# made in the UI (Providers page), never by an environment variable.
CC_FREE_MODE=1

# --- optional convenience ----------------------------------------------------
TZ=UTC

# ---------------------------------------------------------------------------
# Docker Compose only (read by docker-compose.yml, not by the app):
#   CC_BIND            host interface to publish on — default 127.0.0.1
#   CC_MEMORY_LIMIT    container memory ceiling — default 2g
#   HERMES_REF         upstream Hermes branch/tag to build — default main
#   POSTGRES_*         only used with the optional `--profile postgres`
#
# There is deliberately no variable that mirrors keys into $HERMES_HOME/.env or
# that unlocks paid providers: both are security-relevant switches that require an
# explicit action by a signed-in administrator.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# API keys: do NOT put provider keys here.
#
# Store them in the app (Keys page) where they are encrypted at rest, masked in
# the UI, never returned to a browser, redacted from logs and excluded from Git.
# A key in this file would be readable by anything that can read the file.
# ---------------------------------------------------------------------------
